# Copy to deploy/.env. Everything is optional; these are the development defaults.
POSTGRES_PASSWORD=docsearch_dev
POSTGRES_PORT=5433
S3_PORT=8333
API_PORT=8080

# Set a key to require it on every /v1 route (the UI asks for it).
DOCSEARCH_API_KEY=

# Semantic and image search: 1 to enable (and build the API with DOCSEARCH_SEMANTIC_BUILD=1).
DOCSEARCH_SEMANTIC=
DOCSEARCH_SEMANTIC_BUILD=0

# Speech-to-text language for recordings (hi, mr, en ...); empty detects it, which fails on Hindi/Marathi.
DOCSEARCH_ASR_LANGUAGE=
