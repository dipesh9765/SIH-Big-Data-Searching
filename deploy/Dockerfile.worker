# syntax=docker/dockerfile:1
# Ingestion worker with OCR (Tesseract: English, Hindi, Marathi + pypdfium2) and speech-to-text
# (faster-whisper; the model is downloaded into the image at build time, so workers run offline).
#   docker build -f deploy/Dockerfile.worker -t docsearch-worker .
#   docker build -f deploy/Dockerfile.worker --target test -t docsearch-worker-test .   (with dev tools)
FROM python:3.13-slim AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-hin tesseract-ocr-mar \
 && rm -rf /var/lib/apt/lists/*
ENV PYTHONUNBUFFERED=1 OMP_THREAD_LIMIT=1
# OMP_THREAD_LIMIT=1: Tesseract's own threading oversubscribes cores when several workers run;
# scale by running more workers instead.
WORKDIR /app
COPY requirements.txt requirements-ocr.txt requirements-asr.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ocr.txt -r requirements-asr.txt
# Whisper model size. small (~480 MB) is the default: the base model (~140 MB, ~2.5x faster) made
# visible errors even on clean English and produced nothing usable for Hindi/Marathi (ADR 0012).
ARG ASR_MODEL=small
ENV DOCSEARCH_ASR_MODEL=${ASR_MODEL} DOCSEARCH_ASR_MODEL_DIR=/models
RUN python -c "from faster_whisper import WhisperModel; import os; WhisperModel(os.environ['DOCSEARCH_ASR_MODEL'], device='cpu', compute_type='int8', download_root='/models')"  && chmod -R a+rX /models
# Semantic and image search. Kept as its own layers after the speech model so rebuilding it
# does not re-download Whisper.
COPY requirements-semantic.txt ./
RUN pip install --no-cache-dir -r requirements-semantic.txt
# Embedding models for semantic and image search: multilingual text (384-d, covers Hindi and
# Marathi), and CLIP text/vision towers for searching images with words (512-d, English-centric).
ENV DOCSEARCH_EMBED_CACHE=/models/embed
RUN python -c "from fastembed import ImageEmbedding, TextEmbedding; c='/models/embed'; TextEmbedding('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2', cache_dir=c); TextEmbedding('Qdrant/clip-ViT-B-32-text', cache_dir=c); ImageEmbedding('Qdrant/clip-ViT-B-32-vision', cache_dir=c)"  && chmod -R a+rX /models
ENV HF_HUB_OFFLINE=1

FROM base AS worker
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps . \
 && useradd --system --uid 10001 --create-home app
USER app
ENTRYPOINT ["python", "-m", "docsearch.ingest.worker"]
CMD ["--kinds", "ocr", "--compact-interval", "0"]

# Test image: fonts to render sample pages, dev tools. Source is mounted at run time (-v .:/app).
FROM base AS test
# espeak-ng and ffmpeg synthesise speech and build sample audio/video for the tests.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      fonts-dejavu-core fonts-lohit-deva espeak-ng ffmpeg \
 && rm -rf /var/lib/apt/lists/*
COPY requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
ENV PYTHONPATH=/app/src:/app PYTHONDONTWRITEBYTECODE=1
CMD ["pytest", "-q", "--no-cov"]
